{
  "name": "end-of-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"stage-*/*.js\"",
    "test:watch": "node --test --watch \"stage-*/*.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playground": "npm start --prefix playground",
    "playground:build": "npm run build --prefix playground",
    "docs": "node scripts/build-docs.mjs",
    "docs:dev": "npm run docs && vitepress dev docs",
    "docs:build": "npm run docs && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "vitepress": "^1.6.4"
  }
}
